{
  "name": "@ashebanow/pi-gotgenes-subagent",
  "version": "0.1.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "default": "./src/service/service.ts"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "default": "./src/layered-settings.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "docs/*.md",
    "docs/architecture",
    "docs/decisions",
    "CHANGELOG.md"
  ],
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "description": "Soft fork of @gotgenes/pi-subagents — a focused, in-process sub-agent core for pi with Reviewer agent added. Autonomous agents plus a typed API and lifecycle events other extensions build on.",
  "author": {
    "name": "Andrew Shebanow",
    "email": "ashebanow@cattivi.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashebanow/pi-gotgenes-subagent.git",
    "directory": "packages/pi-subagents"
  },
  "homepage": "https://github.com/ashebanow/pi-gotgenes-subagent/tree/main/packages/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/ashebanow/pi-gotgenes-subagent/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagent",
    "agent",
    "autonomous"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.75.0",
    "@earendil-works/pi-coding-agent": ">=0.75.0",
    "@earendil-works/pi-tui": ">=0.75.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build:types": "rollup -c rollup.dts.config.mjs",
    "prepack": "pnpm run build:types",
    "verify:public-types": "bash scripts/verify-public-types.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:md": "rumdl check *.md docs/**/*.md",
    "lint": "biome check . && eslint . && pnpm run lint:md"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@earendil-works/pi-ai": "0.79.1",
    "@earendil-works/pi-coding-agent": "0.79.1",
    "@earendil-works/pi-tui": "0.79.1",
    "@types/node": "catalog:",
    "rollup": "^4.61.1",
    "rollup-plugin-dts": "^6.4.1",
    "rumdl": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
